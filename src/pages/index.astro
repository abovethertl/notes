---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				width: 100vw;
				margin-left: calc(-50vw + 50%);
				margin-bottom: 3rem;
			}
			.hero img {
				width: 100%;
				height: auto;
				display: block;
				max-height: 60vh;
				object-fit: cover;
			}
			.intro {
				max-width: 720px;
				margin: 0 auto;
				padding: 0 1rem 4rem;
			}
			.intro h1 {
				font-size: 2em;
				margin-bottom: 1rem;
			}
			.intro .tagline {
				font-size: 1.15em;
				color: rgb(var(--gray-dark));
				font-style: italic;
				margin-bottom: 2rem;
			}
			.intro p {
				line-height: 1.7;
				margin-bottom: 1.25rem;
			}
			.cta {
				margin-top: 2.5rem;
			}
			.cta a {
				font-weight: 600;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="hero">
				<img src="/hero-clock-towers.png" alt="Two Victorian clock towers rising from morning fog, connected by a stone bridge" />
			</div>
			<div class="intro">
				<h1>Above the RTL · Notes</h1>
				<p class="tagline">Two clocks. One bridge. The rest is engineering.</p>
				<p>
					Technical reference notes accompanying <a href="https://www.abovethertl.com">abovethertl.com</a> — the Substack publication on AI and chip design, written from inside the industry.
				</p>
				<p>
					This site hosts the longer technical material that sits behind the narrative posts: CDC physics, synchronizer analysis, MTBF arithmetic, archetype catalogs, and the kind of detail that would bog down a post but matters to engineers actually closing sign-off.
				</p>
				<p class="cta">
					<a href="/blog">Browse the notes →</a>
				</p>
			</div>
		</main>
		<Footer />
	</body>
</html>
